<Window x:Class="Programowanie3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programowanie3"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="400">
    <Grid Background="#FFBAB8B8">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="12*"/>
                    <RowDefinition Height="12*"/>
                    <RowDefinition Height="12*"/>
                    <RowDefinition Height="12*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ButtonAC" Content="AC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Background="#FFEA0000"/>
                <Button x:Name="ButtonER" Content="←"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Background="#FFFF6767" Grid.Column="1"/>
                <Button x:Name="ButtonSQRT" Content="√" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Background="White" Grid.Column="2"/>
                <Button x:Name="Button3" Content="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="3" Grid.Column="2"/>
                <Button x:Name="Button8" Content="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="1" Grid.Column="1"/>
                <Button x:Name="Button9" Content="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="1" Grid.Column="2"/>
                <Button x:Name="Button4" Content="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="2"/>
                <Button x:Name="Button5" Content="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="2" Grid.Column="1" Click="Button_Click_1"/>
                <Button x:Name="Button6" Content="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="2" Grid.Column="2"/>
                <Button x:Name="Button1" Content="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="3"/>
                <Button x:Name="Button2" Content="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="3" Grid.Column="1"/>
                <Button x:Name="Button7" Content="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="1" Click="Button_Click_2"/>
                <Button x:Name="Button0" Content="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="4" Background="#FFDDDDDD"/>
                <Button x:Name="ButtonDOT" Content="." HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="4" Grid.Column="1" Background="#FFDDDDDD"/>
                <Button x:Name="ButtonEQ" Content="=" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="4" Grid.Column="2" Background="White"/>

            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="12*"/>
                    <RowDefinition Height="12*"/>
                    <RowDefinition Height="24*"/>
                </Grid.RowDefinitions>
                <Button x:Name="ButtonDIV" Content="/" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Background="White"/>
                <Button x:Name="ButtonMUL" Content="*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="1" Background="White"/>
                <Button x:Name="ButtonMIN" Content="-" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="2" Background="White"/>
                <Button x:Name="ButtonPLUS" Content="+" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,10,5" Grid.Row="3" Background="White"/>
            </Grid>

        </Grid>
        <TextBox x:Name="TextBoxResult" TextWrapping="Wrap" Background="#FFEBEBEB"/>
    </Grid>

</Window>
