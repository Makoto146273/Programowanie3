<Window x:Class="Programowanie3.Task3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programowanie3"
        mc:Ignorable="d"
        Title="Task3" Height="500" Width="500">

    <DockPanel LastChildFill="True">

        <Button x:Name="Bottom" Content="Bottom"
            DockPanel.Dock="Bottom"
            Height="50"
            FontSize="20"/>

        <Button x:Name="Left" Content="Left"
            DockPanel.Dock="Left"
            Width="50"
            FontSize="20"/>

        <Button x:Name="Right" Content="Right"
            DockPanel.Dock="Right"
            FontSize="20"/>

        <Button x:Name="Top" Content="Top"
            DockPanel.Dock="Top"
            Height="100"
            FontSize="20"
            Background="Red"/>

        <Button x:Name="Top2" Content="Top2"
            DockPanel.Dock="Top"
            Height="160"
            Margin="120,0,120,0"
            Background="#FF009400"
            FontSize="20"/>

        <Button x:Name="Right2" Content="Right2"
            DockPanel.Dock="Right"
            Width="80"
            Margin="0,30,0,30"
            FontSize="20"/>

        <Button x:Name="Right3" Content="Right3"
            DockPanel.Dock="Right"
            Width="80"
            Margin="0,30,0,30"
            FontSize="20"/>

        <Button x:Name="Top3" Content="Top3"
            DockPanel.Dock="Top"
            Height="70"
            FontSize="20"
            Background="#FF0000E1"/>

        <Button x:Name="Fill" Content="Fill"
            FontSize="20"/>

    </DockPanel>

</Window>
