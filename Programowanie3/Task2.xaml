<Window x:Class="Programowanie3.Task2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kółko i krzyżyk"
        Height="500" Width="400"
        MinHeight="400" MinWidth="300">

    <DockPanel Margin="15">

        <StackPanel DockPanel.Dock="Top">
            <Label Content="KÓŁKO I KRZYŻYK"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalContentAlignment="Center"/>

            <Border x:Name="StatusIndicator"
                    Height="18"
                    Margin="5,10"
                    CornerRadius="8"
                    Background="Red"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom"
                Content="Nowa gra"
                FontSize="18"
                Height="45"
                Margin="5"
                Click="NewGame_Click"/>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="B0" Grid.Row="0" Grid.Column="0"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B1" Grid.Row="0" Grid.Column="1"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B2" Grid.Row="0" Grid.Column="2"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B3" Grid.Row="1" Grid.Column="0"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B4" Grid.Row="1" Grid.Column="1"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B5" Grid.Row="1" Grid.Column="2"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B6" Grid.Row="2" Grid.Column="0"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B7" Grid.Row="2" Grid.Column="1"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

            <Button x:Name="B8" Grid.Row="2" Grid.Column="2"
                    FontSize="40" FontWeight="Bold"
                    Click="Cell_Click"/>

        </Grid>

    </DockPanel>
</Window>
