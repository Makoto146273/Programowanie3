<Window x:Class="Programowanie3.Task2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programowanie3"
        mc:Ignorable="d"
        Title="Task2" Height="450" Width="800">
    <StackPanel Margin="20">

                <TextBlock Text="Dodawanie nowego studenta"
                   FontSize="20"
                   FontWeight="Bold"/>

                <TextBlock Text="Imię:"/>
                <TextBox x:Name="ImieTextBox"
                 Margin="0,5,0,10"/>

                <TextBlock Text="Nazwisko:"/>
                <TextBox x:Name="NazwiskoTextBox"
                 Margin="0,5,0,10"/>

                <TextBlock Text="Data urodzenia:"/>
                <DatePicker x:Name="DataUrodzeniaPicker"
                    Margin="0,5,0,10"/>

                <TextBlock Text="Semestr:"/>
                <ComboBox x:Name="SemestrComboBox"
                  SelectedIndex="0"
                  Margin="0,5,0,20">
                    <ComboBoxItem Content="Semestr 1"/>
                    <ComboBoxItem Content="Semestr 2"/>
                    <ComboBoxItem Content="Semestr 3"/>
                    <ComboBoxItem Content="Semestr 4"/>
                    <ComboBoxItem Content="Semestr 5"/>
                    <ComboBoxItem Content="Semestr 6"/>
            <ComboBoxItem Content="Semestr 7"/>
        </ComboBox>

                <Button Content="Dodaj studenta"
                Height="35"/>

            </StackPanel>
        </Window>

